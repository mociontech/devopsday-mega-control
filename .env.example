# Mega Control: variables del SERVIDOR de este proyecto (no llegan al navegador). En Netlify se cargan en el panel del sitio.
# Este archivo está en .gitignore: nunca se sube.

# Base compartida (Supabase). La clave de servicio se copia del panel: Project Settings > API Keys > secret key.
SUPABASE_URL=https://jvhxghykvifkggekcdvi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Evius (Datahub). Pon EVIUS_MODE=live para activar el envío; con cualquier otro valor no se manda nada.
EVIUS_MODE=off
EVIUS_URL=
EVIUS_TOKEN=
EVIUS_EVENT_ID=
EVIUS_EXPERIENCE_ID=
EVIUS_SOURCE=devopsdays-bogota-2026
